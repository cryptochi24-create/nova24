{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova24",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "8253b3c1-82a9-4b15-a129-f3a445d38fd5","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "04a06166e1ff46d5bec02ce0af77cb99" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
